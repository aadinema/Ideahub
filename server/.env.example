# IdeaHub Server Environment Variables
# Copy this file to .env and fill in values. Never commit .env to version control.

# ---------------------------------------------------------------------------
# Node
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ---------------------------------------------------------------------------
# MongoDB — choose one connection string based on your deployment target
# See DEPLOYMENT.md for full guidance.
# ---------------------------------------------------------------------------

# Option A: Local Docker Compose (dev)
MONGODB_URI=mongodb://localhost:27017/ideahub

# Option B: MongoDB Atlas (recommended for production)
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/ideahub?retryWrites=true&w=majority

# Option C: On-premise replica set
# MONGODB_URI=mongodb://host1:27017,host2:27017,host3:27017/ideahub?replicaSet=rs0

# ---------------------------------------------------------------------------
# JWT — generate secrets with: node -e "require('crypto').randomBytes(64).toString('hex')"
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=REPLACE_WITH_64_BYTE_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_BYTE_RANDOM_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Email / SMTP (Nodemailer)
# Dev: use Mailtrap (https://mailtrap.io) or MailHog
# Prod: replace with Exchange/SMTP relay credentials
# ---------------------------------------------------------------------------
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=REPLACE_WITH_MAILTRAP_USER
SMTP_PASS=REPLACE_WITH_MAILTRAP_PASS
EMAIL_FROM=noreply@ideahub.mpoline.in
EMAIL_FROM_NAME=IdeaHub

# ---------------------------------------------------------------------------
# File Storage
# Dev: local disk (StorageProvider = local)
# Prod: set STORAGE_PROVIDER=s3 and fill S3 vars
# ---------------------------------------------------------------------------
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=./uploads

# S3-compatible (AWS S3, MinIO, Azure Blob S3 compat)
# STORAGE_PROVIDER=s3
# S3_BUCKET=ideahub-attachments
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=REPLACE
# S3_SECRET_ACCESS_KEY=REPLACE
# S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com  # or MinIO endpoint

# ---------------------------------------------------------------------------
# Seed
# ---------------------------------------------------------------------------
SEED_DEFAULT_PASSWORD=IdeaHub@Dev2026!

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info
